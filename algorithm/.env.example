# Copy to .env locally. Never put these values in NEXT_PUBLIC_* variables.
GOOGLE_AI_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=idea-wave-513901
GOOGLE_CLOUD_LOCATION=global
# Only required for GOOGLE_AI_BACKEND=developer
GEMINI_API_KEY=
# Select models available to your project before live execution.
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
